# Copia questo file accanto a ScreenAI.exe e rinominalo open.env.
# Inserisci soltanto le chiavi che possiedi. Non pubblicare mai questo file.

GROQ_API_KEY=""
GOOGLE_API_KEY=""
OPENROUTER_API_KEY=""
OPENCODE_API_KEY=""

# Ollama locale non richiede una chiave. Questi valori sono facoltativi.
# OLLAMA_ENDPOINT="http://127.0.0.1:11434"
# OLLAMA_MODEL="qwen3-vl:4b"
# OLLAMA_EXECUTABLE="E:\Ollama\ollama.exe"

# Facoltativo: forza un modello preciso. Se omesso, ScreenAI prova i modelli predefiniti.
# GROQ_MODEL="qwen/qwen3.8-27b"
# GOOGLE_MODEL="gemini-3.5-flash-lite"
# OPENROUTER_MODEL="google/gemini-3-flash-preview"
